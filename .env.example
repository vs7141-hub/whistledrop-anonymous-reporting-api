# Copy this file to .env and fill in YOUR values. Never commit .env.
NODE_ENV=development
PORT=3000

# PostgreSQL connection string: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://whistle:CHANGE_ME@localhost:5432/whistledrop"
# A SEPARATE database used only by `npm test` (its name must contain "test"; it gets wiped!)
TEST_DATABASE_URL="postgresql://whistle:CHANGE_ME@localhost:5432/whistledrop_test"

# Secrets - at least 32 characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
CASE_CODE_PEPPER=
JWT_EXPIRES_IN=1h

# Comma-separated browser origins allowed to call the API (empty = none)
CORS_ORIGINS=
# Number of reverse proxies in front of the app (0 when running locally)
TRUST_PROXY=0
BCRYPT_ROUNDS=12

# Optional rate-limit tuning (defaults shown)
# GLOBAL_RATE_LIMIT_MAX=300   # requests / 15 min / IP
# REPORT_RATE_LIMIT_MAX=10    # reports / hour / IP
# LOOKUP_FAILED_MAX=10        # failed case-code lookups / 15 min / IP
# LOGIN_FAILED_MAX=5          # failed logins / 15 min / IP

# Only used by `npm run seed` to create the first ADMIN account
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
